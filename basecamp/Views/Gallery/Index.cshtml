@{
    ViewData["Title"] = "Gallery | Basecamp Bar, Casino & Hotel";
}

<section class="container py-5 text-light gallery-page">

    <div class="text-center mb-5">
        <p class="section-eyebrow">Explore Basecamp</p>

        <h1 class="display-5 fw-bold">
            Gallery
        </h1>

        <p class="lead text-light">
            Take a look inside Basecamp's mountain lodge atmosphere, gaming area,
            food and drinks, hotel accommodations, and community events.
        </p>
    </div>

    <div class="row g-4">

        <!-- Bar & Lounge -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="barGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/bar-gallery1.jpg" class="gallery-card-img" alt="Bar and lounge at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/bar-gallery2.jpg" class="gallery-card-img" alt="Interior seating area at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/bar-gallery3.jpg" class="gallery-card-img" alt="Mountain lodge atmosphere at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/bar-gallery4.jpg" class="gallery-card-img" alt="Inside Basecamp Bar and Lounge in Seeley Lake Montana" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#barGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#barGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Bar & Lounge</div>
            </div>
        </div>

        <!-- Casino -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="casinoGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/casino-photo1.jpg" class="gallery-card-img" alt="Casino gaming area at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/casino-photo2.jpg" class="gallery-card-img" alt="Gaming machines at Basecamp Casino in Seeley Lake Montana" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#casinoGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#casinoGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Casino</div>
            </div>
        </div>

        <!-- Food & Drinks -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="foodGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/menu.jpg" class="gallery-card-img" alt="Food and drinks menu at Basecamp in Seeley Lake Montana" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#foodGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#foodGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Food & Drinks</div>
            </div>
        </div>

        <!-- Hotel Rooms -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="hotelGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/hotel-exterior.jpg" class="gallery-card-img" alt="Basecamp hotel exterior" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hotel-entry.jpg" class="gallery-card-img" alt="Basecamp hotel entry" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hotel-hallway.jpg" class="gallery-card-img" alt="Basecamp hotel hallway" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hotel-room1.jpg" class="gallery-card-img" alt="Basecamp hotel room" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hotel-room2.jpg" class="gallery-card-img" alt="Basecamp hotel room" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hotel-bathroom.jpg" class="gallery-card-img" alt="Basecamp hotel bathroom" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#hotelGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#hotelGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Hotel Rooms</div>
            </div>
        </div>

        <!-- Events / Patio -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="eventsGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/basecamp-patio.jpg" class="gallery-card-img" alt="Outdoor patio at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/basecamp-patio2.jpg" class="gallery-card-img" alt="Patio seating at Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/basecamp-yard.jpg" class="gallery-card-img" alt="Outdoor gathering area at Basecamp in Seeley Lake Montana" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#eventsGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#eventsGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Events</div>
            </div>
        </div>

        <!-- Exterior -->
        <div class="col-md-6 col-lg-4">
            <div class="gallery-card">
                <div id="exteriorGallery" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/basecamp-exterior.jpg" class="gallery-card-img" alt="Exterior of Basecamp Bar Casino and Hotel in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/basecamp-exterior2.jpg" class="gallery-card-img" alt="Front entrance of Basecamp in Seeley Lake Montana" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/basecamp-yard.jpg" class="gallery-card-img" alt="Basecamp outdoor area" />
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#exteriorGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#exteriorGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="gallery-card-label">Exterior</div>
            </div>
        </div>

    </div>

    <div class="contact-card mt-5">
        <h2 class="h4 mb-3">More Photos Coming Soon</h2>

        <p class="mb-0">
            We're currently updating our gallery with new photos showcasing the
            atmosphere, amenities, events, food, drinks, gaming, and lodging available at Basecamp.
        </p>
    </div>

</section>