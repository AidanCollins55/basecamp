@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="container py-5 text-light privacy-page">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <p class="section-eyebrow">Basecamp</p>

            <h1 class="display-5 fw-bold mb-4">
                Privacy Policy
            </h1>

            <div class="contact-card">

                <p class="mb-4">
                    Basecamp respects your privacy and is committed to protecting any
                    information you may provide while using this website.
                </p>

                <h2 class="h4 mt-4 mb-3">Information We Collect</h2>

                <p>
                    This website may collect basic information submitted through contact
                    forms, inquiries, or other voluntary interactions. This may include:
                </p>

                <ul>
                    <li>Name</li>
                    <li>Email address</li>
                    <li>Phone number</li>
                    <li>General inquiry details</li>
                </ul>

                <h2 class="h4 mt-4 mb-3">How Information Is Used</h2>

                <p>
                    Information submitted through this website is used only for responding
                    to inquiries, improving customer experience, and communicating about
                    services, events, lodging, or business operations related to Basecamp.
                </p>

                <h2 class="h4 mt-4 mb-3">Third-Party Services</h2>

                <p>
                    This website may use third-party services such as Google Maps,
                    social media platforms, or website analytics tools that may collect
                    standard usage information in accordance with their own privacy policies.
                </p>

                <h2 class="h4 mt-4 mb-3">Cookies</h2>

                <p>
                    Basic website cookies or analytics tools may be used to improve
                    website functionality and visitor experience.
                </p>

                <h2 class="h4 mt-4 mb-3">Data Security</h2>

                <p>
                    Reasonable efforts are made to protect submitted information, though
                    no internet transmission or electronic storage method can be guaranteed
                    completely secure.
                </p>

                <h2 class="h4 mt-4 mb-3">Contact</h2>

                <p class="mb-0">
                    If you have questions regarding this privacy policy, please contact Basecamp directly.
                </p>

            </div>
        </div>
    </div>
</section>