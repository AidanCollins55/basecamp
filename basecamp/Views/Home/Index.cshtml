@{
    ViewData["Title"] = "Basecamp Bar, Casino & Hotel | Seeley Lake, Montana";
}

<!-- HERO SECTION -->
<section class="hero-section text-light d-flex align-items-center">
         
    <div class="container text-center">
        <h1 class="display-3 fw-bold">Basecamp</h1>
        <p class="lead">Bar • Casino • Hotel</p>
        <p class="mt-3">
            Your mountain-town gathering place for cold drinks, hot pizza,
            gaming, and a comfortable place to stay the night.
        </p>
    </div>
</section>

<!-- FEATURE SECTIONS -->
<section class="container py-5 text-light">

    <div class="home-intro">
        <h2>Welcome to Basecamp</h2>
        <div class="home-intro">

            <p>
                Located in the heart of Seeley Lake, Montana, Basecamp offers a full-service bar,
                casino gaming, hotel accommodations, food, drinks, and a welcoming mountain-town atmosphere.
                Whether you're visiting the lake, exploring nearby trails, or simply looking for a place to
                relax with friends, Basecamp is your destination for lodging, dining, entertainment, and local hospitality.
            </p>
        </div>
    </div>

    <a asp-controller="FoodDrinks" asp-action="Index" class="content-panel-link">
        <div class="row align-items-center content-panel">
            <div class="col-md-6">
                <img src="~/images/brewpub-logo.png"
                     alt="Basecamp Food & Drinks in Seeley Lake Montana"
                     class="img-fluid rounded shadow brewpub-logo.png" />
            </div>

            <div class="col-md-6">
                <h2>Food & Drinks</h2>
                <p>
                    Loaded nachos, hot pizza, cold beer, and everything you need
                    for a relaxed night with friends.
                </p>

                <span class="btn btn-outline-light">
                    View Menu
                </span>
            </div>
        </div>
    </a>

    <a asp-controller="Casino" asp-action="Index" class="content-panel-link">
        <div class="row align-items-center content-panel flex-md-row-reverse">

            <div class="col-md-6">
                <img src="~/images/casino-photo1.jpg"
                     alt="Casino gaming area at basecamp in Seeley Lake Montana"
                     class="img-fluid rounded shadow home-section-img" />
            </div>

            <div class="col-md-6">
                <h2>Casino</h2>

                <p>
                    Enjoy Montana gaming machines in a laid-back lodge atmosphere.
                </p>

                <span class="btn btn-outline-light">
                    Learn More
                </span>
            </div>

        </div>
    </a>

    <a asp-controller="Hotel" asp-action="Index" class="content-panel-link">
        <div class="row align-items-center content-panel">

            <div class="col-md-6">
                <img src="~/images/hotel-room1.jpg"
                     alt="Hotel room at Basecamp in Seeley Lake Montana"
                     class="img-fluid rounded shadow home-section-img" />
            </div>

            <div class="col-md-6">
                <h2>Stay the Night</h2>

                <p>
                    Comfortable lodging right here at Basecamp. Perfect after a
                    long day on the river, trail, or road.
                </p>

                <span class="btn btn-outline-light">
                    View Rooms
                </span>
            </div>

        </div>
    </a>

    <div class="row align-items-center content-panel flex-md-row-reverse">

        <div class="col-md-6">
            <img src="~/images/basecamp-exterior.jpg"
                 alt="Exterior of Basecamp Bar Casino and Hotel in Seeley Lake Montana"
                 class="img-fluid rounded shadow home-section-img" />
        </div>

        <div class="col-md-6">
            <h2>Hours & Location</h2>

            <p>
                Stop in for a drink, a game, a bite to eat, or a comfortable night’s stay.
                Basecamp is a relaxed stop for locals and travelers passing through Seeley Lake.
            </p>

            <div class="hours-block mb-3">
                <p class="mb-2">
                    <strong>Monday:</strong> Closed
                </p>
                <p class="mb-2">
                    <strong>Tuesday – Thursday:</strong> 11:00 AM – 12:00 AM
                </p>
                <p class="mb-2">
                    <strong>Friday – Saturday:</strong> 11:00 AM – 2:00 AM
                </p>
                <p class="mb-0">
                    <strong>Sunday:</strong> 11:00 AM – 12:00 AM
                </p>
            </div>

            <p class="mb-2">
                <strong>Hotel:</strong><br />
                <a href="tel:+14068616355" class="phone-link">
                    Call Lisa at (406) 861-6355
                </a>
            </p>

            <p class="mb-4">
                <strong>Basecamp:</strong><br />
                <a href="tel:+14066772848" class="phone-link">
                    Call Basecamp at (406) 677-2848
                </a>
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-outline-light">
                Get Directions
            </a>
        </div>

    </div>

</section>