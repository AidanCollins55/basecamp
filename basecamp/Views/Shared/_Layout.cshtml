<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="description"
          content="Basecamp in Seeley Lake, Montana offers food, drinks, casino gaming, hotel lodging, and a welcoming mountain-town atmosphere for locals and visitors." />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - basecamp</title>
    <!-- Loads Bootstrap's built-in CSS so we can use Bootstrap classes like navbar, container, nav-link, etc. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <meta property="og:title" content="Basecamp Bar, Casino & Hotel | Seeley Lake, Montana" />
    <meta property="og:description" content="Basecamp in Seeley Lake, Montana offers food, drinks, casino gaming, hotel lodging, and a relaxed mountain-town atmosphere." />
    <meta property="og:image" content="https://seeleybasecamp.com/images/basecamp-logo.jpg" />
    <meta property="og:url" content="https://seeleybasecamp.com" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Basecamp Bar, Casino & Hotel | Seeley Lake, Montana" />
    <meta name="twitter:description" content="Basecamp in Seeley Lake, Montana offers food, drinks, casino gaming, hotel lodging, and a relaxed mountain-town atmosphere." />
    <meta name="twitter:image" content="https://seeleybasecamp.com/images/basecamp-logo.jpg" />

    <!-- Loads your main custom site-wide CSS file. This is where most Basecamp styling will go. -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Loads auto-generated project styling from ASP.NET. The asp-append-version helps prevent browser cache issues. -->
    <link rel="stylesheet" href="~/basecamp.styles.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="~/images/basecamp-logo.jpg" />
</head>
<body>
    <header>
        <!-- Main navigation bar shown at the top of every page because this file is the shared layout. -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Site brand/logo area. Clicking this sends users back to the Home page. -->
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/basecamp-logo.jpg"
                         alt="Basecamp logo"
                         class="site-logo" />

                    <span>Basecamp</span>
                </a>

                <!-- Mobile hamburger button. This appears when the screen is too small for the full nav menu. -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible navigation menu. Bootstrap hides/shows this on smaller screens. -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto">

                        <!-- Each nav item uses ASP.NET tag helpers to link to a controller/action route. -->
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="FoodDrinks" asp-action="Index">Food & Drinks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Casino" asp-action="Index">Casino</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Hotel" asp-action="Index">Hotel</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Gallery" asp-action="Index">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main page content wrapper.
    Removed Bootstrap container so homepage hero can span full width.
    Individual pages still control their own spacing using section containers. -->
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- Site-wide footer shown at the bottom of every page. -->
    <footer class="site-footer text-light">
        <div class="container py-5">
            <div class="row g-4 align-items-start">

                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/images/basecamp-logo.jpg"
                             alt="Basecamp logo"
                             class="footer-logo" />

                        <div>
                            <h2 class="h5 mb-1">Basecamp</h2>
                            <p class="mb-0 footer-muted">Bar • Casino • Hotel</p>
                        </div>
                    </div>

                    <p class="footer-muted mb-0">
                        A relaxed mountain-town stop in Seeley Lake for drinks, gaming,
                        food, lodging, and local atmosphere.
                    </p>
                </div>

                <div class="col-lg-2 col-md-4">
                    <h3 class="h6 footer-heading">Explore</h3>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="FoodDrinks" asp-action="Index">Food & Drinks</a></li>
                        <li><a asp-controller="Casino" asp-action="Index">Casino</a></li>
                        <li><a asp-controller="Hotel" asp-action="Index">Hotel</a></li>
                        <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                        <li><a asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h3 class="h6 footer-heading">Visit</h3>

                    <p class="footer-muted mb-2">
                        3363 MT-83<br />
                        Seeley Lake, MT 59868
                    </p>

                    <p class="footer-muted mb-2">
                        Tuesday – Sunday<br />
                        11am – 2am
                    </p>

                    <p class="footer-muted mb-0">
                        Closed Monday
                    </p>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h3 class="h6 footer-heading">Contact</h3>

                    <p class="mb-2">
                        <a href="tel:14066772848">(406) 677-2848</a>
                    </p>

                    <p class="mb-3">
                        <a href="https://www.facebook.com/profile.php?id=61587695232047"
                           target="_blank"
                           rel="noopener">
                            Follow us on Facebook
                        </a>
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Get Directions
                    </a>
                </div>

            </div>

            <hr class="footer-divider" />

            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 footer-bottom">
                <p class="mb-0">
                    &copy; @DateTime.Now.Year Basecamp. All rights reserved.
                </p>

                <p class="mb-0">
                    <a href="https://www.codebycollins.com/"
                       target="_blank"
                       rel="noopener">
                        Website by CodeByCollins
                    </a>
                </p>
            </div>
        </div>
    </footer>

    <!-- Loads jQuery, Bootstrap JavaScript, and your custom site JavaScript. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Allows individual pages to inject extra scripts only when needed. -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>