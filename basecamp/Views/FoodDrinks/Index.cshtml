@{
    ViewData["Title"] = "Food & Drinks | Basecamp Bar & Restaurant | Seeley Lake MT";
}

<section class="container py-5 text-light food-page">
    <div class="row align-items-center g-5">

        <div class="col-lg-6">
            <p class="section-eyebrow">Good Food & Cold Drinks</p>

            <h1 class="display-5 fw-bold mb-3">
                Food & Drinks
            </h1>

            <p class="lead text-light">
                Whether you're stopping in for lunch, dinner, a late-night bite, or drinks with friends,
                Basecamp offers a welcoming atmosphere and classic favorites.
            </p>

            <p>
                Enjoy loaded nachos, hot pizza, cold beer, cocktails, and more while relaxing in our
                mountain lodge setting. Whether you're here to watch the game, meet up with friends,
                or unwind after a day in Seeley Lake, there's always a seat waiting for you.
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-outline-light mt-3">
                Visit Basecamp
            </a>
        </div>

        <div class="col-lg-6">
            <img src="~/images/menu.jpg"
                 alt="Food and drinks menu at Basecamp in Seeley Lake Montana"
                 class="img-fluid rounded shadow food-page-img" />
        </div>

    </div>

    <div class="row g-4 mt-5">

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Pizza & Favorites</h2>
                <p class="mb-0">
                    Hot pizza, loaded nachos, and satisfying pub-style favorites served throughout the day.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Beer & Cocktails</h2>
                <p class="mb-0">
                    Ice-cold beer, cocktails, and your favorite drinks ready whenever you're in the mood.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Local Atmosphere</h2>
                <p class="mb-0">
                    A relaxed gathering place for locals and travelers alike in the heart of Seeley Lake.
                </p>
            </div>
        </div>

    </div>
</section>