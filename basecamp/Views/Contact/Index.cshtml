@{
    ViewData["Title"] = "Contact  Basecamp | Seeley Lake Montana";
}

<section class="container py-5 text-light contact-page">
    <div class="row align-items-stretch g-5">

        <!-- LEFT SIDE -->
        <div class="col-lg-6">
            <p class="section-eyebrow">Visit Basecamp</p>

            <h1 class="display-5 fw-bold mb-3">
                Contact & Location
            </h1>

            <p class="lead text-light">
                Stop in for a drink, a game, a bite to eat, or a comfortable place to stay.
                Basecamp is your relaxed mountain lodge destination in Seeley Lake.
            </p>

            <div class="contact-card mt-4 contact-info-card d-flex flex-column">
                <div>
                    <h2 class="h4 mb-3">Basecamp</h2>

                    <p class="mb-3">
                        <strong>Address:</strong><br />
                        3363 MT-83<br />
                        Seeley Lake, MT 59868
                    </p>

                    <p class="mb-3">
                        <strong>Call Basecamp Bar and Casino:</strong><br />
                        <a href="tel:14066772848">(406) 677-2848</a>
                    </p>

                    <p class="mb-3">
                        <strong>Call Lisa for lodging:</strong><br />
                        <a href="tel:14068616355">(406) 861-6355</a>
                    </p> 


                    <p class="mb-3">
                        <strong>Hours:</strong><br />
                        Tuesday – Sunday: 11am – 2am
                    </p>

                    <p class="mb-0">
                        <strong>Closed:</strong><br />
                        Monday
                    </p>
                </div>

                <div class="mt-auto text-end pt-4">
                    <a href="https://facebook.com/"
                       target="_blank"
                       rel="noopener"
                       class="btn btn-outline-light">
                        Visit Our Facebook
                    </a>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-6">
            <div class="contact-card h-100 d-flex flex-column">
                <div>
                    <h2 class="h4 mb-3">Find Us</h2>

                    <div class="ratio ratio-4x3 rounded overflow-hidden shadow">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2711.099210494296!2d-113.49979842645877!3d47.19507067260852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x535d74cf95dfae7f%3A0xd59f2a1b5aa1d6ae!2sBase%20Camp%20Bar%2C%20Casino%2C%20and%20Lodge!5e0!3m2!1sen!2sus!4v1778535491590!5m2!1sen!2sus" 
                        width="600" height="450" style="border:0;" 
                        allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                    </div>
                </div>

                <div class="mt-auto text-end pt-4">
                    <a class="btn btn-outline-light"
                       href="https://maps.app.goo.gl/aRAnMBCPWmyoDNsX6"
                       target="_blank"
                       rel="noopener">
                        Get Directions
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- EXTERIOR PHOTO -->
    <div class="location-photo-section mt-5">
        <img src="~/images/basecamp-exterior.jpg"
             alt="Basecamp Bar Casino and Hotel located in Seeley Lake Montana"
             class="img-fluid rounded shadow location-photo-img" />
    </div>
    </section>
