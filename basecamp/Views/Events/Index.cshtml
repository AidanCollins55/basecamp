@{
    ViewData["Title"] = "Events  | Basecamp | Seeley Lake MT";
}

<section class="container py-5 text-light events-page">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">
            <p class="section-eyebrow">What's Happening at Basecamp</p>

            <h1 class="display-5 fw-bold mb-3">
                Events
            </h1>

            <p class="lead text-light">
                From live music and community gatherings to seasonal celebrations and special events,
                there's always something happening at Basecamp.
            </p>

            <p>
                We love bringing people together. Whether you're a local looking for a fun night out
                or a visitor passing through Seeley Lake, Basecamp is a great place to relax, meet friends,
                and enjoy the atmosphere.
            </p>

            <a href="https://www.facebook.com/profile.php?id=61587695232047"
               target="_blank"
               rel="noopener"
               class="btn btn-outline-light mt-3">
                Follow Events on Facebook
            </a>
        </div>

        <div class="col-lg-6">
            <div class="contact-card upcoming-events-card">

                <h2 class="h4 mb-4">Upcoming Events</h2>

                <div class="text-center py-4">
                    <div class="mb-4">
                        <h3 class="h5 mb-3">Event Information Coming Soon</h3>

                        <p class="mb-0">
                            We're currently updating our event calendar.
                            Check back soon for live music, special events,
                            tournaments, community gatherings, and seasonal happenings at Basecamp.
                        </p>
                    </div>

                    <hr />

                    <div class="mt-4">
                        <h3 class="h5 mb-2">Bingo Night</h3>

                        <p class="mb-1">
                            Join us every Tuesday for Bingo at Basecamp.
                        </p>

                        <p class="mb-2">
                            <strong>6:00 PM</strong>
                        </p>

                        <small class="text-muted">
                            Please note: Bingo will not be held next Tuesday, but will resume weekly every Tuesday thereafter.
                        </small>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="row g-4 mt-5">

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Live Entertainment</h2>
                <p class="mb-0">
                    Watch for upcoming live music, special performances, and community events.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Special Nights</h2>
                <p class="mb-0">
                    Join us for seasonal events, themed nights, and special promotions throughout the year.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="contact-card h-100">
                <h2 class="h5">Community Gatherings</h2>
                <p class="mb-0">
                    Basecamp is a gathering place for locals and visitors looking to connect and have a good time.
                </p>
            </div>
        </div>

    </div>

    <div class="contact-card mt-5">
        <h2 class="h4 mb-3">Stay Updated</h2>

        <p class="mb-0">
            Event schedules are updated regularly. Follow us on Facebook for the latest information
            on live music, special events, promotions, and community gatherings.
        </p>
    </div>

</section>